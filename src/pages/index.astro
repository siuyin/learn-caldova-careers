---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RoleCard from '../components/RoleCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { sortByNewest } from '../lib/jobs';
import type { Job } from '../types/job';

export const prerender = true;

const entries = await getCollection('jobs');
const jobs: Job[] = sortByNewest(
    entries.map((entry) => ({ slug: entry.id, ...entry.data })),
);
const departments = [...new Set(jobs.map((job) => job.department))].sort((a, b) =>
    a.localeCompare(b),
);
const locations = [...new Set(jobs.map((job) => job.location))].sort((a, b) =>
    a.localeCompare(b),
);
---

<Layout title="Caldova Careers — Open roles">
  <div class="py-8">
    <section class="mb-10">
      <h1 class="text-4xl font-bold text-slate-100 mb-3">Build the future of medicine</h1>
      <p class="text-lg text-slate-400 max-w-2xl">
        Caldova is an AI-native pharmaceutical company. Explore our open roles
        and help us bring better treatments to patients faster.
      </p>
    </section>

    <h2 class="text-2xl font-medium mb-6 text-slate-100">Open roles</h2>

    <section class="mb-8" aria-label="Filter open roles">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_auto] gap-4 items-end">
        <div>
          <label for="department-filter" class="block text-sm font-medium text-slate-300 mb-2">
            Department
          </label>
          <select
            id="department-filter"
            data-testid="department-filter"
            aria-controls="roles-grid"
            class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">All departments</option>
            {departments.map((department) => <option value={department}>{department}</option>)}
          </select>
        </div>
        <div>
          <label for="location-filter" class="block text-sm font-medium text-slate-300 mb-2">
            Location
          </label>
          <select
            id="location-filter"
            data-testid="location-filter"
            aria-controls="roles-grid"
            class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">All locations</option>
            {locations.map((location) => <option value={location}>{location}</option>)}
          </select>
        </div>
        <button
          type="button"
          data-testid="role-filter-reset"
          class="rounded-lg border border-slate-600 px-4 py-2 text-slate-200 hover:border-blue-500 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          Reset filters
        </button>
      </div>
    </section>

    {jobs.length === 0 && (
      <EmptyState text="There are no open roles right now. Check back soon." />
    )}

    <div
      id="role-filter-empty-state"
      data-testid="role-filter-empty-state"
      role="status"
      aria-live="polite"
      hidden
      class="mb-6"
    >
      <EmptyState text="No roles match these filters. Adjust or reset your filters to see more roles." />
    </div>

    <div
      id="roles-grid"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
      data-testid="roles-grid"
      hidden={jobs.length === 0}
    >
      {jobs.map((job) => <RoleCard job={job} />)}
    </div>
  </div>
</Layout>

<script>
  import { filterJobs } from '../lib/jobs';

  /** Filter-relevant data exposed on each rendered role card. */
  interface FilterableRole {
    slug: string;
    department: string;
    location: string;
  }

  /** Find a required role-filter control or throw if the page markup is incomplete. */
  function requireElement<T extends Element>(selector: string): T {
    const element = document.querySelector<T>(selector);
    if (!element) {
      throw new Error(`Required role filter element not found: ${selector}`);
    }
    return element;
  }

  const departmentFilter = requireElement<HTMLSelectElement>('[data-testid="department-filter"]');
  const locationFilter = requireElement<HTMLSelectElement>('[data-testid="location-filter"]');
  const resetButton = requireElement<HTMLButtonElement>('[data-testid="role-filter-reset"]');
  const rolesGrid = requireElement<HTMLDivElement>('[data-testid="roles-grid"]');
  const emptyState = requireElement<HTMLDivElement>('[data-testid="role-filter-empty-state"]');
  const roleCards = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-testid="role-card"]'),
  );
  const roles: FilterableRole[] = roleCards.map((card) => {
    const { jobId: slug, department, location } = card.dataset;
    if (!slug || !department || !location) {
      throw new Error('A role card is missing its filter data.');
    }
    return { slug, department, location };
  });

  /** Apply the current selections to role visibility and the no-results message. */
  function updateVisibleRoles(): void {
    const matchingSlugs = new Set(
      filterJobs(roles, {
        department: departmentFilter.value,
        location: locationFilter.value,
      }).map((role) => role.slug),
    );
    const hasMatches = matchingSlugs.size > 0;

    for (const card of roleCards) {
      card.hidden = !matchingSlugs.has(card.dataset.jobId ?? '');
    }

    rolesGrid.hidden = !hasMatches;
    emptyState.hidden = hasMatches || roles.length === 0;
  }

  departmentFilter.addEventListener('change', updateVisibleRoles);
  locationFilter.addEventListener('change', updateVisibleRoles);
  resetButton.addEventListener('click', () => {
    departmentFilter.value = '';
    locationFilter.value = '';
    updateVisibleRoles();
  });
</script>
